# FateFlow — exemplo de ambiente (NUNCA commitar o .env real com segredos)
NODE_ENV=production
PORT=3000

# MySQL de produção (preencher na VPS, ficheiro com chmod 600)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Passwords do contentor MySQL (só usadas pelo docker-compose na VPS)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# URL pública da app (sem barra final). Usada no redirect_uri do Google.
APP_URL=https://SEU_DOMINIO.com

# Google OAuth — criar em https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://SEU_DOMINIO.com/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segredo HS256 das sessões (mín. 32 caracteres aleatórios).
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
