# FateFlow — anexar no fim de /home/orven/orven/deploy/Caddyfile (como root) e reload.
# Pré-requisito: DNS `fateflow.ddaorven.com` em modo "Somente DNS" (cinzento).
# A app está ligada à rede `deploy_default`, por isso o Caddy alcança-a por nome.

# 4. FateFlow (Anime Watch Tracker)
fateflow.{$DOMAIN} {
	encode gzip
	reverse_proxy fateflow-app:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	log {
		output stdout
		format json
	}
}
